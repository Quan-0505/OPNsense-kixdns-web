<?php

/*
 * KixDNS plugin service registration
 *
 * NOTE: /etc/rc.conf.d/kixdns is NOT written from PHP any more.
 *       The web frontend runs as user "www" and can never write into /etc,
 *       so the old kixdns_configure_do() silently failed and the service was
 *       never enabled. rc.conf.d is generated by the configd template
 *       OPNsense/KixDNS (see service/templates/OPNsense/KixDNS/+TARGETS),
 *       which runs as root - the standard OPNsense mechanism.
 */

function kixdns_enabled()
{
    return (string)(new \OPNsense\KixDNS\KixDNS())->general->enabled == '1';
}

/**
 * Expose the kixdns log file in Diagnostics -> Log Files.
 * The daemon logs through daemon(8) -S -T kixdns, so syslog-ng sees program
 * "kixdns" and the local filter template routes it to
 * /var/log/kixdns/kixdns_<date>.log - exactly the path the viewer derives
 * from the app/facility pair below.
 */
function kixdns_syslog()
{
    return [
        'kixdns' => [
            'facility' => ['kixdns'],
        ],
    ];
}

function kixdns_services()
{
    $services = [];

    if (kixdns_enabled()) {
        $services[] = [
            'description' => gettext('KixDNS'),
            'configd' => [
                'restart' => ['kixdns restart'],
                'start' => ['kixdns start'],
                'stop' => ['kixdns stop'],
            ],
            'name' => 'kixdns',
            'pidfile' => '/var/run/kixdns.pid',
        ];
    }

    return $services;
}

function kixdns_xmlrpc_sync()
{
    $result = [];

    $result[] = [
        'description' => gettext('KixDNS'),
        'section' => 'OPNsense.kixdns',
        'id' => 'kixdns',
        'services' => ['kixdns'],
    ];

    return $result;
}
